Créer le cluster:

gcloud dataproc clusters create mon-cluster-flink \
    --project=stagel2 \
    --region=europe-west9 \
    --zone=europe-west9-a \
    --single-node \
    --master-machine-type=e2-standard-4 \
    --master-boot-disk-size=100GB \
    --image-version=2.1-debian11 \
    --optional-components=FLINK \
    --enable-component-gateway
    
    
gcloud storage cp target/*.jar gs://mon-benchmark-flink-12345/
    
gcloud dataproc jobs submit flink \
    --cluster=mon-cluster-flink \
    --region=europe-west9 \
    --class=com.benchmark.NexmarkQuery5Job \
    --jars=gs://mon-benchmark-flink-12345/flink-state-benchmark-1.0-SNAPSHOT.jar
    
    
    
Supprimer le cluster: 
gcloud dataproc clusters delete mon-cluster-flink \
    --project=stagel2 \
    --region=europe-west9 \
    --quiet
    
    
